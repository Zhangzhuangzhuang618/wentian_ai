# 复制为.env后填写。不要提交.env。
WENTIAN_POSTGRES_PASSWORD=
WENTIAN_S3_ACCESS_KEY=
WENTIAN_S3_SECRET_KEY=
WENTIAN_SESSION_SECRET=
WENTIAN_GEO_CONNECTOR_MASTER_SECRET=
WENTIAN_PUBLIC_ORIGIN=http://127.0.0.1:3000
WENTIAN_COOKIE_SECURE=false
WENTIAN_DOUBAO_AUTOMATION_ENVIRONMENT=production
WENTIAN_DOUBAO_AUTOMATION_AUTHORIZATION_BASIS=none
# WENTIAN_DOUBAO_AUTOMATION_AUTHORIZATION_EVIDENCE_ID=<approved-evidence-id>
# WENTIAN_DOUBAO_AUTOMATION_AUTHORIZATION_REVIEWED_AT=<ISO-8601 timestamp>
WENTIAN_QIANWEN_AUTOMATION_ENVIRONMENT=production
WENTIAN_QIANWEN_AUTOMATION_AUTHORIZATION_BASIS=none
# WENTIAN_QIANWEN_AUTOMATION_AUTHORIZATION_EVIDENCE_ID=<approved-evidence-id>
# WENTIAN_QIANWEN_AUTOMATION_AUTHORIZATION_REVIEWED_AT=<ISO-8601 timestamp>
WENTIAN_OBJECT_STORE_BUCKET=wentian-evidence
WENTIAN_API_PORT=3000
WENTIAN_POSTGRES_PORT=5432
WENTIAN_S3_PORT=9000
WENTIAN_S3_CONSOLE_PORT=9001

# Owner初始化时临时注入；初始化成功后删除。
# WENTIAN_OWNER_INIT_TOKEN_SHA256=<sha256-of-one-time-token>
# WENTIAN_OWNER_INIT_TOKEN=<one-time-plaintext-token>
# WENTIAN_OWNER_EMAIL=owner@example.com
# WENTIAN_OWNER_DISPLAY_NAME=Owner
# WENTIAN_OWNER_PASSWORD=<long-unique-password>
