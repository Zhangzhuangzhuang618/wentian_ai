{
  "name": "wentian",
  "version": "0.0.0",
  "private": true,
  "description": "问天AI信源探测系统",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev:api": "node --experimental-strip-types apps/api/src/main.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "owner:init": "node --experimental-strip-types scripts/bootstrap-owner.ts",
    "retention:run": "node --experimental-strip-types scripts/run-retention-cleanup.ts",
    "validate:consumer-flow": "node --experimental-strip-types scripts/validate-standalone-consumer-flow.ts",
    "validate:geo-connector": "node --experimental-strip-types scripts/validate-geo-connector-flow.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types packages/*/test/*.test.ts packages/adapters/*/test/*.test.ts apps/*/test/*.test.ts",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "standalone:check": "node scripts/check-standalone-foundation.mjs",
    "openapi:check": "node --experimental-strip-types scripts/check-consumer-observation-openapi.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm test && pnpm boundaries:check && pnpm standalone:check && pnpm openapi:check && pnpm format:check"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "^8.23.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
